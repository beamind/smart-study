# Release signing for the Android app. Copy to one of these places (never into git):
#   %USERPROFILE%\.smartstudy\keystore.properties   (default)
#   <repo>\keystore.properties                      (ignored by git)
#   any path set in the SMART_STUDY_KEYSTORE_PROPERTIES environment variable
# storeFile may be relative to this file. See docs/decisions/003-release-signing.md.
# Write an absolute path with / (storeFile=C:/Users/me/.smartstudy/smartstudy-release.jks): in this file a single \ is an escape character.
storeFile=smartstudy-release.jks
storePassword=
keyAlias=smartstudy
keyPassword=
