{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "isolatedModules": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["vite/client", "node"], "noUnusedLocals": true, "noUnusedParameters": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src", "server", "tools", "e2e", "vite.config.ts", "capacitor.config.ts", "playwright.config.ts"]
}
