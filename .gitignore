# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle files
.gradle/
build/
tools/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/workspace.xml
.idea/tasks.xml
.idea/gradle.xml
.idea/assetWizardSettings.xml
.idea/dictionaries
.idea/libraries
.idea/jarRepositories.xml
.idea/caches
.idea/modules.xml
.idea/.name
.idea/compiler.xml
.idea/misc.xml
.idea/vcs.xml
.idea/shelf

# Keystore files
*.jks
*.keystore
keystore/


# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Third-party library binaries (should be managed via dependencies)
android-image-cropper-*/
*.zip
classes-*.jar

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Version control
vcs.xml

# lint
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/
# lint/reports/

# IDE (extra safety)
.idea/
.vscode/

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*~

# Android build byproducts (extra safety)
*.idsig
*.hprof

# Secrets (extra safety)
# 建议把敏感信息放在：
# - 全局 %USERPROFILE%\\.gradle\\gradle.properties（不进仓库）
# - 或环境变量
# - 或本项目根目录的 keystore.properties（不进仓库）
keystore.properties
**/keystore.properties
# Local Gradle user home (cache) - must not be committed
.gradle-user-home/

# UI dump / screenshots generated during debugging
ui*.xml
track*.png
