<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Layout_StandardPage">

    <!-- Toolbar -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_standard" />
    
    <!-- 用户列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/spacing_xl"
        android:layout_marginEnd="@dimen/spacing_xl"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_lg"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toTopOf="@id/layoutBottomButtons"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 底部按钮容器 -->
    <LinearLayout
        android:id="@+id/layoutBottomButtons"
        style="@style/Layout_BottomButtons"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 注册按钮 -->
        <Button
            android:id="@+id/btnAddUser"
            style="@style/Button_Bottom"
            android:text="@string/register"
            android:layout_marginEnd="@dimen/spacing_md" />

        <!-- 切换按钮 -->
        <Button
            android:id="@+id/btnConfirm"
            style="@style/Button_Bottom"
            android:text="@string/switch_user" />
    </LinearLayout>

    <!-- 空状态提示 -->
    <LinearLayout
        android:id="@+id/layoutEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_users"
            android:textSize="18sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="@dimen/spacing_md" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/click_to_add_user"
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
