<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/spacing_md"
    android:paddingEnd="@dimen/spacing_md"
    android:paddingTop="@dimen/spacing_sm"
    android:paddingBottom="@dimen/spacing_sm"
    android:gravity="center_vertical"
    android:background="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/tvRank"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <CheckBox
        android:id="@+id/cbSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/spacing_sm"
        android:visibility="gone"
        android:buttonTint="@color/checkbox_button_tint" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        
        <EditText
            android:id="@+id/etWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/word"
            android:textSize="18sp"
            android:textColor="@color/text_primary"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:minHeight="0dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false" />
        
        <EditText
            android:id="@+id/etTranslation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            android:background="@android:color/transparent"
            android:padding="0dp"
            android:minHeight="0dp"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:clickable="false"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvErrorCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/error_count_format"
        android:textSize="14sp"
        android:textColor="@color/error_red"
        android:layout_marginStart="@dimen/spacing_sm" />

</LinearLayout>
