<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Layout_StandardPage">

    <!-- Toolbar -->
    <include
        android:id="@+id/toolbar"
        layout="@layout/layout_toolbar_standard" />

    <!-- 顶部进度卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardProgress"
        style="@style/Card_Progress"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            style="@style/Layout_ProgressContent">

            <TextView
                android:id="@+id/tvWordIndex"
                style="@style/Text_ProgressIndex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/word_index"
                android:textColor="@color/primary_blue"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCurrentWord"
                style="@style/Text_ProgressCurrent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/current_word"
                android:textSize="28sp"
                android:textColor="@color/primary_blue"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 照片显示卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardPhoto"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/radius_xl"
        app:cardElevation="@dimen/elevation_md"
        app:cardBackgroundColor="@color/card_background"
        app:layout_constraintTop_toBottomOf="@id/cardProgress"
        app:layout_constraintBottom_toTopOf="@id/cardAnswers"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivPhoto"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="@color/divider"
            android:contentDescription="拍摄的照片" />

        <!-- 占位提示 -->
        <LinearLayout
            android:id="@+id/placeholderLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/background_light">
        </LinearLayout>
        
        <!-- 裁剪视图容器（默认隐藏） -->
        <FrameLayout
            android:id="@+id/cropContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#000000">
            
            <com.canhub.cropper.CropImageView
                android:id="@+id/cropImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
            
            <!-- 裁剪操作按钮（浮动在裁剪视图底部） -->
            <LinearLayout
                android:id="@+id/cropButtonLayout"
                style="@style/Layout_CropButtons"
                android:visibility="gone"
                android:layout_gravity="bottom">
                
                <Button
                    android:id="@+id/btnCropCancel"
                    style="@style/Button_CropAction"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="@string/cancel"
                    android:backgroundTint="@color/button_gray" />
                
                <Button
                    android:id="@+id/btnCropDone"
                    style="@style/Button_CropAction"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="@string/finish"
                    android:backgroundTint="@color/primary_blue" />
            </LinearLayout>
        </FrameLayout>
    </androidx.cardview.widget.CardView>

    <!-- 答案显示卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAnswers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/spacing_xl"
        android:visibility="gone"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/card_background"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="false"
        app:layout_constraintTop_toBottomOf="@id/cardProgress"
        app:layout_constraintBottom_toTopOf="@id/cardActions"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_lg"
            android:paddingBottom="@dimen/spacing_lg"
            android:paddingTop="0dp">

            <TextView
                android:id="@+id/tvAnswersTitle"
                style="@style/Text_AnswerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dictation_answer"
                android:layout_marginStart="@dimen/spacing_md"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/submit_error_words"
                android:layout_marginTop="@dimen/spacing_md"
                style="@style/Button_Primary"
                android:elevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvAnswers"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/tvAnswersTitle"
                app:layout_constraintBottom_toTopOf="@id/btnSubmit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

    <!-- 操作按钮卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_xl"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxl"
            android:gravity="center_horizontal">

            <!-- 新的听写按钮 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnTakePhoto"
                style="@style/Card_ActionButton">

                <LinearLayout
                    style="@style/Layout_ActionButtonContent"
                    android:background="@drawable/bg_button_blue_gradient">

                    <!-- 图标 -->
                    <ImageView
                        style="@style/Image_ActionButtonIcon"
                        android:src="@android:drawable/ic_menu_camera"
                        android:tint="@color/primary_blue"
                        android:contentDescription="新的听写图标" />

                    <!-- 文字内容 -->
                    <TextView
                        style="@style/Text_ActionButton"
                        android:text="@string/take_photo" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- 错题查看按钮 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnViewErrors"
                style="@style/Card_ActionButton">

                <LinearLayout
                    style="@style/Layout_ActionButtonContent"
                    android:background="@drawable/bg_button_green_gradient">

                    <!-- 图标 -->
                    <ImageView
                        style="@style/Image_ActionButtonIcon"
                        android:src="@android:drawable/ic_menu_sort_by_size"
                        android:tint="@color/accent_green"
                        android:contentDescription="错题查看图标" />

                    <!-- 文字内容 -->
                    <TextView
                        style="@style/Text_ActionButton"
                        android:text="@string/view_error_words" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- 错题听写按钮 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnErrorDictation"
                style="@style/Card_ActionButton">

                <LinearLayout
                    style="@style/Layout_ActionButtonContent"
                    android:background="@drawable/bg_button_orange_gradient">

                    <!-- 图标 -->
                    <ImageView
                        style="@style/Image_ActionButtonIcon"
                        android:src="@drawable/ic_mic"
                        android:tint="@color/accent_orange"
                        android:contentDescription="错题听写图标" />

                    <!-- 文字内容 -->
                    <TextView
                        style="@style/Text_ActionButton"
                        android:text="@string/error_dictation" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            
            <!-- 开始听写按钮（监听页面显示） -->
            <Button
                android:id="@+id/btnStartDictation"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="@dimen/spacing_md"
                android:visibility="gone"
                android:text="@string/start_dictation"
                style="@style/Button_Primary"
                android:elevation="0dp" />

            <!-- 开始听写温馨提示卡片 -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardStartTip"
                style="@style/Card_Tip"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:visibility="gone">

                <LinearLayout
                    style="@style/Layout_TipContent">

                    <!-- 标题 -->
                    <TextView
                        style="@style/Text_TipTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/tips"
                        android:textColor="@color/primary_blue"
                        android:gravity="center" />

                    <!-- 内容 -->
                    <TextView
                        android:id="@+id/tvStartTip"
                        style="@style/Text_TipContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/dictation_waiting_start_hint"
                        android:textColor="@color/primary_blue"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 状态显示 -->
            <LinearLayout
                android:id="@+id/statusLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginBottom="@dimen/spacing_md"
                    android:indeterminateTint="@color/primary_blue" />

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/listening"
                    style="@style/Text_Caption"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 语音识别内容高亮卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRecognition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:layout_marginTop="@dimen/spacing_md"
        android:layout_marginBottom="@dimen/spacing_md"
        android:visibility="gone"
        app:cardCornerRadius="@dimen/radius_lg"
        app:cardElevation="@dimen/elevation_md"
        app:cardBackgroundColor="@color/icon_bg_blue"
        app:layout_constraintTop_toBottomOf="@id/cardProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="120dp"
            android:orientation="vertical"
            android:padding="@dimen/spacing_xxl"
            android:gravity="center">

            <TextView
                android:id="@+id/tvRecognitionStatus"
                style="@style/Text_RecognitionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/recognition_in_progress"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvRecognitionText"
                style="@style/Text_RecognitionText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/primary_blue" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 温馨提示卡片 -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardTip"
        style="@style/Card_Tip"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/cardProgress"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            style="@style/Layout_TipContent">

            <!-- 标题 -->
            <TextView
                style="@style/Text_TipTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/tips"
                android:textColor="@color/primary_blue"
                android:gravity="center" />

            <!-- 内容 -->
            <TextView
                android:id="@+id/tvTip"
                style="@style/Text_TipContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dictation_tip_after_finish"
                android:textColor="@color/primary_blue"
                android:gravity="center" />

            <!-- 下一个按钮 -->
            <Button
                android:id="@+id/btnNext"
                style="@style/Button_TipAction"
                android:text="@string/next"
                android:backgroundTint="@color/primary_blue" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>

