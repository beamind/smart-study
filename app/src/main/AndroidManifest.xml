<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 权限声明 -->
    <!-- 网络权限：用于调用 API 服务（TTS、ASR 等） -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!-- 摄像头权限：用于拍照识别词语（听写功能） -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 权限用途说明：仅用于听写练习时拍照识别词语，不会用于其他用途 -->

    <!-- 麦克风权限：用于语音识别控制听写进度（听写功能） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 权限用途说明：仅用于听写练习时的语音识别，不会用于录音或窃听 -->


    <!--
         注意：不要申请 WAKE_LOCK。
         某些场景下，部分厂商安全扫描会把"后台保持运行、防止休眠"判为高风险特征。
         听写功能仅在前台使用，通过 Window FLAG_KEEP_SCREEN_ON 保持亮屏即可。
    -->

    <!-- 硬件特性声明 -->
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:name=".SmartStudyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartStudy"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="false"
        android:hardwareAccelerated="true"
        android:largeHeap="false"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="standard">
            <intent-filter>
                <!--LAUNCHER表明MainActivity是启动入口-->
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".dictation.chinese.ChineseDictationActivity"
            android:exported="false" />

        <activity
            android:name=".dictation.english.EnglishDictationActivity"
            android:exported="false" />

        <activity
            android:name=".dictation.ErrorWordListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".dictation.DictationRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".user.UserManagementActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".english.EnglishErrorBookActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".learningrecord.LearningRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- 收紧第三方库导出组件：不允许外部 App 直接拉起裁剪 Activity -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:exported="false"
            tools:replace="android:exported" />

        <!-- 听写仅在 Activity 前台运行：不启用前台服务（可降低安全软件对"后台录音上传"的误报） -->

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- 应用描述元数据：帮助降低安全扫描误报 -->
        <meta-data
            android:name="com.android.application.description"
            android:value="@string/app_description" />

        <!-- 明确声明应用用途，降低误报 -->
        <meta-data
            android:name="app_category"
            android:value="education" />

        <!-- 声明应用为教育工具，所有敏感权限仅用于教育功能 -->
        <meta-data
            android:name="app_purpose"
            android:value="education_tool" />

        <!-- 权限使用说明：帮助安全软件理解权限用途 -->
        <meta-data
            android:name="permission_usage_explanation"
            android:value="相机和麦克风用于听写练习" />

        <!-- 明确声明：应用不包含短信、电话、下载安装等功能 -->
        <meta-data
            android:name="app_security_declaration"
            android:value="本应用为教育工具，不包含发送短信、拨打电话、下载安装应用、诱导扣费等功能。所有权限仅用于听写练习功能。" />

        <!-- 应用类型：教育类应用 -->
        <meta-data
            android:name="android.content.pm.category"
            android:value="education" />
    </application>

</manifest>
